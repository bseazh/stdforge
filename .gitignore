# MinerU results include source documents and generated binary assets.
data/mineru/
pdf-parser/.runtime/
module3/source/.runtime/

# Runtime knowledge documents and indexes persist beside the application but are not source files.
KDB/.system/
KDB/*/text/
KDB/*/source/

# Local secrets must never enter the repository.
.env
.env.*

# Installed dependencies are restored from package-lock.json.
node_modules/
