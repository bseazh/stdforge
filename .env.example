# SMTP credentials belong only in the ignored .env.local file or deployment secrets.
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-163-address@163.com
SMTP_PASS=your-smtp-authorization-code
SMTP_FROM=StdForge <your-163-address@163.com>
NOTIFICATION_RECIPIENTS=reviewer@example.com
NOTIFICATION_COOLDOWN_MS=60000
NOTIFICATION_TEST_ACCESS_TOKEN=replace-with-a-random-test-access-token
NOTIFICATION_TEST_RECIPIENT_LIMIT=10

# Optional OpenAI-compatible LLM used only after KDB retrieval. Keep these values in a local ignored env file or deployment Secret.
LLM_BASE_URL=https://your-llm-endpoint.example/v1
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=your-model-name

# Feishu document used by the Module 1 "同步到飞书协同" action. Keep the actual
# value only in .env.local or a deployment Secret; it is appended to, never overwritten.
FEISHU_DOCUMENT_URL=https://your-tenant.feishu.cn/wiki/your-wiki-token
