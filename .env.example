# All values below are examples only. Credentials belong only in ignored local files or deployment Secrets.

# Document parsing and local PDF text extraction.
MINERU_TOKEN=replace-with-your-mineru-token
PDFTOTEXT_BIN=pdftotext

# Server runtime. HOST and PORT are normally set by the deployment environment.
HOST=127.0.0.1
PORT=4173

# SMTP credentials belong only in the ignored .env.local file or deployment secrets.
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-163-address@163.com
SMTP_PASS=your-smtp-authorization-code
SMTP_FROM=StdForge <your-163-address@163.com>
NOTIFICATION_RECIPIENTS=reviewer@example.com
NOTIFICATION_COOLDOWN_MS=60000
NOTIFICATION_TEST_ACCESS_TOKEN=replace-with-a-random-test-access-token
NOTIFICATION_TEST_RECIPIENT_LIMIT=10

# Optional OpenAI-compatible LLM used only after KDB retrieval. Keep these values in a local ignored env file or deployment Secret.
LLM_BASE_URL=https://your-llm-endpoint.example/v1
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=your-model-name

# Feishu document used by the Module 1 "同步到飞书协同" action. Keep the actual
# value only in .env.local or a deployment Secret; it is appended to, never overwritten.
FEISHU_DOCUMENT_URL=https://your-tenant.feishu.cn/wiki/your-wiki-token
FEISHU_APP_ID=cli_your_feishu_app_id
FEISHU_APP_SECRET=replace-with-your-feishu-app-secret
FEISHU_APPROVAL_CODE=replace-with-your-approval-code
FEISHU_INITIATOR_OPEN_ID=replace-with-your-open-id

# Policy and bilingual services may use dedicated models. Omit them to use the module defaults.
POLICY_LLM_BASE_URL=https://your-policy-llm-endpoint.example/v1
POLICY_LLM_API_KEY=replace-with-your-policy-llm-api-key
POLICY_LLM_MODEL=your-policy-model-name
BILINGUAL_LLM_BASE_URL=https://your-translation-llm-endpoint.example/v1
BILINGUAL_LLM_API_KEY=replace-with-your-translation-llm-api-key
BILINGUAL_LLM_MODEL=your-translation-model-name
